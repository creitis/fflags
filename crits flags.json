P.BackgroundColor3=Color3.fromRGB(100,100,100)
Instance.new("UICorner",P).CornerRadius=UDim.new(0,6)

local function Q()
	local R=M.Text
	local S=O.Text
	local T=D.Character or D.CharacterAdded:Wait()
	if T:WaitForChild("Uniform",5) then
		E:FireServer("Game","Customization","Toggle","LeftGlove")
		E:FireServer("Game","Customization","Toggle","RightGlove")
		E:FireServer("Game","Customization","Number",S)
		E:FireServer("Game","Customization","Name",R)
	end
end

P.MouseButton1Click:Connect(Q)

C.InputBegan:Connect(function(U,proc)
	if not proc then
		local k = U.KeyCode
		if k==Enum.KeyCode.DPadUp or k==Enum.KeyCode.Q then
			H.Visible=not H.Visible
		end
	end
end)


