N.TextColor3=Color3.fromRGB(60,60,60)
N.BackgroundTransparency=1
N.Position=UDim2.new(0,10,0,55)
N.Size=UDim2.new(0,100,0,18)

local O=Instance.new("TextBox",K)
O.Size=UDim2.new(0,160,0,24)
O.Position=UDim2.new(0,10,0,73)
O.PlaceholderText="Enter number..."
O.Font=Enum.Font.Gotham
O.TextSize=12
O.TextColor3=Color3.fromRGB(40,40,40)
O.BackgroundColor3=Color3.fromRGB(220,220,220)
Instance.new("UICorner",O).CornerRadius=UDim.new(0,5)

local P=Instance.new("TextButton",K)
P.Size=UDim2.new(0,110,0,28)
P.Position=UDim2.new(0,10,0,105)
P.Text="Apply"
